# Chave da YouTube Data API v3 (Google Cloud Console)
# Sem ela o backend cai em modo mock e nao gasta cota.
YOUTUBE_API_KEY=

# Origens permitidas no CORS, separadas por virgula.
# Dev: http://localhost:5173
# Prod: https://seu-projeto.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Supabase (Postgres gerenciado) - guarda o cache de video/capa e o
# historico de playlists, sobrevivendo a restart/redeploy. Sem essas duas
# vars o app funciona mas sem persistir cache entre reinicios.
SUPABASE_URL=
SUPABASE_KEY=
